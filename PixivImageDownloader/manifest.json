{
  "manifest_version": 3,
  "name": "PixivImageDownloader",
  "version": "1.0",
  "description": "Simple image downloader for pixiv",
  "permissions": [
    "downloads"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://www.pixiv.net/*"
      ],
      "js": ["content.js"]
    }
  ]
}