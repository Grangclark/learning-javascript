{
  "manifest_version": 3,
  "name": "PixivImageDownloader",
  "version": "3.1",
  "description": "Simple image downloader for pixiv with Referer spoofing",
  "permissions": [
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.pximg.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["content.js"]
    }
  ]
}